{
  "name": "deeoverlays",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n editor,integration -c cyan,magenta \"npm run dev:editor\" \"npm run dev:integration\"",
    "dev:editor": "vite",
    "dev:integration": "tsx watch server/index.ts",
    "server:check": "tsc -p server/tsconfig.json",
    "build": "tsc -b && npm run server:check && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "ws": "^8.21.3"
  }
}
